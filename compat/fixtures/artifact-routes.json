{
  "scope": "Pinned Android original-method observations with empty caches and successful fixture loaders; main HTTP attempts do not certify OkHttp scheme acceptance",
  "cases": [
    { "id": "main-http", "role": "main", "source": "http://fixture.invalid/a.jar", "expected": { "kind": "http", "requestUrl": "http://fixture.invalid/a.jar" } },
    { "id": "main-https", "role": "main", "source": "https://fixture.invalid/a.jar", "expected": { "kind": "http", "requestUrl": "https://fixture.invalid/a.jar" } },
    { "id": "main-image", "role": "main", "source": "img+https://fixture.invalid/a.jar", "expected": { "kind": "image", "requestUrl": "https://fixture.invalid/a.jar" } },
    { "id": "main-image-removes-all", "role": "main", "source": "img+http://fixture.invalid/img+bundle.jar?x=img+", "expected": { "kind": "image", "requestUrl": "http://fixture.invalid/bundle.jar?x=" } },
    { "id": "main-binary-removes-embedded-marker", "role": "main", "source": "http://fixture.invalid/img+bundle.jar", "expected": { "kind": "http", "requestUrl": "http://fixture.invalid/bundle.jar" } },
    { "id": "main-assets-attempts-http", "role": "main", "source": "assets://a.jar", "expected": { "kind": "http", "requestUrl": "assets://a.jar" }, "plannerKind": "unsupported" },
    { "id": "main-file-attempts-http", "role": "main", "source": "file:///box/a.jar", "expected": { "kind": "http", "requestUrl": "file:///box/a.jar" }, "plannerKind": "unsupported" },
    { "id": "main-clan-attempts-http", "role": "main", "source": "clan://localhost/box/a.jar", "expected": { "kind": "http", "requestUrl": "clan://localhost/box/a.jar" }, "plannerKind": "unsupported" },
    { "id": "main-uppercase-prefix", "role": "main", "source": "IMG+http://fixture.invalid/a.jar", "expected": { "kind": "http", "requestUrl": "IMG+http://fixture.invalid/a.jar" }, "plannerKind": "unsupported" },
    { "id": "site-http", "role": "site", "source": "http://fixture.invalid/a.jar", "expected": { "kind": "http", "requestUrl": "http://fixture.invalid/a.jar" } },
    { "id": "site-https", "role": "site", "source": "https://fixture.invalid/a.jar", "expected": { "kind": "http", "requestUrl": "https://fixture.invalid/a.jar" } },
    { "id": "site-http-prefix-only", "role": "site", "source": "httpish", "expected": { "kind": "http", "requestUrl": "httpish" } },
    { "id": "site-keeps-embedded-image-marker", "role": "site", "source": "http://fixture.invalid/img+bundle.jar", "expected": { "kind": "http", "requestUrl": "http://fixture.invalid/img+bundle.jar" } },
    { "id": "site-image-unsupported", "role": "site", "source": "img+http://fixture.invalid/a.jar", "expected": { "kind": "unsupported" } },
    { "id": "site-assets-uri", "role": "site", "source": "assets://box/a.jar", "expected": { "kind": "assets", "path": "box/a.jar" } },
    { "id": "site-assets-short", "role": "site", "source": "assets/box/a.jar", "expected": { "kind": "assets", "path": "box/a.jar" } },
    { "id": "site-assets-replaces-all", "role": "site", "source": "assets://assets/box/assets/a.jar", "expected": { "kind": "assets", "path": "box/a.jar" } },
    { "id": "site-assets-prefix-only", "role": "site", "source": "assetsOdd.jar", "expected": { "kind": "assets", "path": "assetsOdd.jar" } },
    { "id": "site-file-three-slashes-external", "role": "site", "source": "file:///box/a.jar", "externalExists": true, "expected": { "kind": "file", "path": "//box/a.jar", "storage": "external" } },
    { "id": "site-file-three-slashes-fallback", "role": "site", "source": "file:///box/a.jar", "externalExists": false, "expected": { "kind": "file", "path": "//box/a.jar", "storage": "fallback" } },
    { "id": "site-file-two-slashes", "role": "site", "source": "file://box/a.jar", "expected": { "kind": "file", "path": "/box/a.jar", "storage": "fallback" } },
    { "id": "site-file-one-slash", "role": "site", "source": "file:/box/a.jar", "expected": { "kind": "file", "path": "box/a.jar", "storage": "fallback" } },
    { "id": "site-file-replaces-all", "role": "site", "source": "file:/box/file:/a.jar", "expected": { "kind": "file", "path": "box/a.jar", "storage": "fallback" } },
    { "id": "site-file-prefix-only", "role": "site", "source": "fileOdd.jar", "expected": { "kind": "file", "path": "fileOdd.jar", "storage": "fallback" } },
    { "id": "site-clan-local-default", "role": "site", "source": "clan://localhost/box/a.jar", "expected": { "kind": "http", "requestUrl": "http://127.0.0.1:9978/file/box/a.jar" } },
    { "id": "site-clan-local-injected", "role": "site", "source": "clan://localhost/box/a.jar", "localAddress": "http://fixture.invalid:9980/", "expected": { "kind": "http", "requestUrl": "http://fixture.invalid:9980/file/box/a.jar" } },
    { "id": "site-clan-local-replaces-all", "role": "site", "source": "clan://localhost/a/clan://localhost/b.jar", "localAddress": "http://fixture.invalid/", "expected": { "kind": "http", "requestUrl": "http://fixture.invalid/file/a/http://fixture.invalid/file/b.jar" } },
    { "id": "site-clan-remote", "role": "site", "source": "clan://192.0.2.5:9900/box/a.jar?x=1", "expected": { "kind": "http", "requestUrl": "http://192.0.2.5:9900/file/box/a.jar?x=1" } },
    { "id": "site-clan-no-path", "role": "site", "source": "clan://example.invalid", "expected": { "kind": "http", "requestUrl": "clan://example.invalid" } },
    { "id": "site-clan-empty-host", "role": "site", "source": "clan:///box/a.jar", "expected": { "kind": "http", "requestUrl": "clan:///box/a.jar" } },
    { "id": "site-clan-uppercase-localhost", "role": "site", "source": "clan://LOCALHOST/box/a.jar", "expected": { "kind": "http", "requestUrl": "http://LOCALHOST/file/box/a.jar" } },
    { "id": "site-uppercase-http-unsupported", "role": "site", "source": "HTTP://fixture.invalid/a.jar", "expected": { "kind": "unsupported" } },
    { "id": "site-content-unsupported", "role": "site", "source": "content://fixture/a.jar", "expected": { "kind": "unsupported" } },
    { "id": "site-relative-unsupported", "role": "site", "source": "./a.jar", "expected": { "kind": "unsupported" } }
  ]
}
